        .quiz-option.selected::before { content: '\f00c'; font-family: 'Font Awesome 6 Free'; font-weight: 900; position: absolute; top: 16px; left: 16px; color: var(--secondary); font-size: 1.1rem; }
        [dir="ltr"] .quiz-option.selected::before { left: auto; right: 16px; }
        .quiz-option-icon { font-size: 24px; color: var(--secondary); margin-bottom: 10px; }
        .quiz-option h4 { font-size: 1.05rem; font-weight: 700; margin-bottom: 4px; }
