        .hero-badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 30px; background: rgba(6, 182, 212, 0.1); border: 1px solid rgba(6, 182, 212, 0.25); color: var(--secondary); font-size: 0.88rem; font-weight: 700; margin-bottom: 24px; }
        .hero-title { font-size: 3.2rem; font-weight: 900; line-height: 1.2; margin-bottom: 20px; }
