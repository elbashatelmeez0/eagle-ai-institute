        .quiz-result-title { font-size: 1.8rem; font-weight: 800; margin-bottom: 12px; color: var(--secondary); }
        .quiz-result-desc { color: var(--text-muted); font-size: 1.05rem; margin-bottom: 24px; max-width: 600px; margin-left: auto; margin-right: auto; }
        .filter-tabs { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin-bottom: 40px; }
        .tab-btn { padding: 10px 22px; border-radius: 30px; background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-muted); font-size: 0.92rem; font-weight: 700; cursor: pointer; transition: var(--transition); }
        .tab-btn:hover, .tab-btn.active { background: var(--primary); color: #ffffff; border-color: var(--primary); box-shadow: 0 4px 15px var(--primary-glow); }
        .courses-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 28px; }
        .course-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 30px; display: flex; flex-direction: column; justify-content: space-between; transition: var(--transition); position: relative; overflow: hidden; }
        .course-card:hover { transform: translateY(-6px); border-color: var(--border-glow); box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.4); background: var(--bg-card-hover); }
        .course-card.featured::before { content: 'الأكثر طلباً ⭐'; position: absolute; top: 20px; left: 20px; background: var(--accent-gold); color: #ffffff; font-size: 0.78rem; font-weight: 800; padding: 4px 12px; border-radius: 20px; box-shadow: 0 2px 10px rgba(245, 158, 11, 0.3); }
        [dir="ltr"] .course-card.featured::before { content: 'Most Popular ⭐'; left: auto; right: 20px; }
        .course-icon { width: 60px; height: 60px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 20px; }
        .icon-parents { background: rgba(245, 158, 11, 0.15); color: var(--accent-gold); }
        .icon-kids { background: rgba(6, 182, 212, 0.15); color: var(--secondary); }
        .icon-teachers { background: rgba(37, 99, 235, 0.15); color: #60a5fa; }
        .icon-pros { background: rgba(16, 185, 129, 0.15); color: var(--success); }
        .course-category { font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; }
        .course-title { font-size: 1.35rem; font-weight: 800; margin-bottom: 12px; line-height: 1.4; }
        .course-desc { font-size: 0.92rem; color: var(--text-muted); margin-bottom: 20px; line-height: 1.6; }
        .course-features { list-style: none; margin-bottom: 24px; padding: 0; }
        .course-features li { font-size: 0.88rem; color: var(--text-main); margin-bottom: 10px; display: flex; align-items: center; gap: 10px; }
        .course-features li i { color: var(--success); font-size: 0.95rem; }
        .course-meta { display: flex; justify-content: space-between; align-items: center; padding-top: 18px; border-top: 1px solid var(--border-color); margin-bottom: 20px; }
        .meta-item { font-size: 0.85rem; color: var(--text-muted); display: flex; align-items: center; gap: 6px; }
