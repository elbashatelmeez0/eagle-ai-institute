        .visual-card { background: linear-gradient(145deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.9)); border: 1px solid var(--border-glow); border-radius: var(--radius-lg); padding: 32px; box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5); position: relative; overflow: hidden; }
        [data-theme="light"] .visual-card { background: linear-gradient(145deg, #ffffff, #f1f5f9); box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.1); }
        .eagle-crest { display: flex; align-items: center; justify-content: center; width: 80px; height: 80px; border-radius: 20px; background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(6, 182, 212, 0.15)); border: 1px solid rgba(245, 158, 11, 0.3); color: var(--accent-gold); font-size: 38px; margin-bottom: 24px; }
        .quote-box { position: relative; margin-bottom: 24px; }
        .quote-text { font-size: 1.05rem; font-style: italic; color: var(--text-main); margin-bottom: 12px; line-height: 1.7; }
        .quote-author { display: flex; align-items: center; gap: 10px; font-size: 0.9rem; font-weight: 700; color: var(--accent-gold); }
        .core-slogan-card { background: rgba(6, 182, 212, 0.08); border: 1px dashed rgba(6, 182, 212, 0.3); border-radius: var(--radius-md); padding: 16px; margin-top: 20px; }
        .core-slogan-card h4 { color: var(--secondary); font-size: 0.95rem; font-weight: 800; margin-bottom: 4px; }
        .core-slogan-card p { color: var(--text-muted); font-size: 0.85rem; }
        section { padding: 80px 0; position: relative; }
        .section-header { text-align: center; max-width: 720px; margin: 0 auto 56px; }
        .section-tag { display: inline-block; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--secondary); background: rgba(6, 182, 212, 0.1); padding: 6px 14px; border-radius: 20px; margin-bottom: 14px; border: 1px solid rgba(6, 182, 212, 0.2); }
        .section-title { font-size: 2.3rem; font-weight: 900; margin-bottom: 16px; line-height: 1.3; }
        .section-subtitle { color: var(--text-muted); font-size: 1.05rem; }
        .quiz-card { background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(30, 41, 59, 0.85)); border: 1px solid var(--border-glow); border-radius: var(--radius-lg); padding: 40px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); max-width: 860px; margin: 0 auto; }
        [data-theme="light"] .quiz-card { background: linear-gradient(135deg, #ffffff, #f8fafc); box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.08); }
        .quiz-step { display: none; }
        .quiz-step.active { display: block; animation: fadeIn 0.4s ease; }
        .quiz-question-title { font-size: 1.3rem; font-weight: 800; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; color: var(--text-main); }
        .quiz-options-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 28px; }
        .quiz-option { background: var(--bg-card); border: 2px solid var(--border-color); border-radius: var(--radius-md); padding: 20px; cursor: pointer; transition: var(--transition); text-align: right; position: relative; }
